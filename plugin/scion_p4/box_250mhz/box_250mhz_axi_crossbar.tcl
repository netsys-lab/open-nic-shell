# *************************************************************************
#//FIN-OVGU Magdeburg
# box_250mhz_axi_crossbar.tcl -- 4 Vitis-IP  crossbar configuration
#Cross bar base addresses and widths now match box_250mhz_address_map.v's

#Verify and change the address width based on requirement
#   M00 = egress translator   base 0x000000  width 19 bit (512KB)
#   M01 = ingress classifier  base 0x080000  width 18 bit (256KB)
#   M02 = ingress translator  base 0x0C0000  width 17 bit (128KB)
#   M03 = dummy               base 0x0E0000  width 12 bit (4KB)
#
# Total address range used: 0x000000-0x0E0FFF, well within box0's existing 1MB
#No system_config address map changes needed.

# *************************************************************************
set axi_crossbar box_250mhz_axi_crossbar
create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name $axi_crossbar
set_property -dict {
    CONFIG.ADDR_RANGES {1}
    CONFIG.NUM_MI {4}
    CONFIG.PROTOCOL {AXI4LITE}
    CONFIG.CONNECTIVITY_MODE {SASD}
    CONFIG.R_REGISTER {1}
    CONFIG.S00_WRITE_ACCEPTANCE {1}
